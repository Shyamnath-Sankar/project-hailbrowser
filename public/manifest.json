{
  "manifest_version": 3,
  "name": "Project Browser",
  "version": "0.1.0",
  "description": "Long-horizon browser agent in a side panel. Bring your own API key.",
  "minimum_chrome_version": "120",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "debugger",
    "webNavigation",
    "alarms",
    "notifications",
    "activeTab"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "src/sidepanel/index.html" },
  "action": { "default_title": "Open Project Browser" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": false,
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ],
  "icons": { "128": "icon128.png" }
}
