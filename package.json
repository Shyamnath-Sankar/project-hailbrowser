{
  "name": "hailbrowser",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source browser agent: Chrome side panel with your own models, an ultrafast decision mode, and an MCP bridge for Claude Code, OpenCode and other agents.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "mcp-server"
  ],
  "scripts": {
    "sync-schemas": "node scripts/sync-schemas.mjs",
    "icons": "node scripts/make-icons.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run check && node --test \"tests/*.test.mjs\"",
    "mcp": "node mcp-server/src/index.js",
    "setup": "node mcp-server/src/index.js setup"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "puppeteer": "^24.43.1"
  }
}
